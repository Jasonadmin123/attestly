# Copy to .env and fill in. Never commit your real .env.
ADMIN_TOKEN=pick-a-long-random-string
PAYTO_ADDRESS=0xYOUR_USDC_WALLET_ADDRESS
PAY_NETWORK=base
PAY_ASSET=USDC
BASE_URL=https://attestly.co
CONTACT_EMAIL=jason@theleadforge.com

# Payment verification:
#  - Leave FACILITATOR_URL blank + ALLOW_UNVERIFIED_PAYMENTS=true to launch in MANUAL mode
#    (jobs are accepted and flagged "unverified_manual"; you reconcile the USDC by hand before signing).
#  - When ready, set FACILITATOR_URL to a real x402 facilitator to verify payments automatically,
#    and set ALLOW_UNVERIFIED_PAYMENTS=false.
FACILITATOR_URL=
ALLOW_UNVERIFIED_PAYMENTS=true

# Email alerts on new jobs (optional). Sign up at resend.com (free), paste the API key.
# With no verified domain, Resend can email the address you signed up with — use that for ALERT_EMAIL.
RESEND_API_KEY=
ALERT_EMAIL=jason@theleadforge.com
ALERT_FROM=Attestly <onboarding@resend.dev>
